# ============================================================
# chiefs-db-migration · variáveis de conexão (copie para .env e
# preencha — o .env está no .gitignore e NUNCA deve ser commitado)
# Carregue com:  set -a; source .env; set +a
# ============================================================

# ---- ORIGEM · Intelligence DB (Railway) — acessada SOMENTE leitura ----
SRC_HOST=
SRC_PORT=
SRC_DB=chiefs_intelligence
SRC_USER=
SRC_PASSWORD=
SRC_SSLMODE=prefer          # o proxy TCP do Railway NÃO suporta SSL

# ---- DESTINO · Postgres principal (Heroku) ----
# credencial DEFAULT do banco (dona das tabelas — TRUNCATE/merge exigem):
#   heroku pg:credentials:url DATABASE_URL --name default -a <app>
DST_HOST=
DST_PORT=5432
DST_DB=
DST_USER=
DST_PASSWORD=
DST_SSLMODE=require

# ---- Schemas ----
DST_SCHEMA=intelligence     # destino da carga das 48 tabelas
APP_SCHEMA=app              # schema do monolito Rails (merge); local/dumps: public

# ---- Só para os scripts psql (montada a partir das variáveis acima) ----
# DST_URL="postgres://$DST_USER:$DST_PASSWORD@$DST_HOST:$DST_PORT/$DST_DB"

# ---- Só para scripts/run-local-validation.sh (dumps locais, fora do repo) ----
# DUMP_INTEL=/caminho/dump-chiefs_intelligence-XXXX.sql
# DUMP_MAIN=/caminho/dump-main-XXXX.sql
